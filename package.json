{
  "name": "pulso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test-training.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker pulso-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.0.0",
    "@vinext/cloudflare": "^1.0.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.0",
    "vite": "^8.3.0"
  },
  "type": "module"
}
