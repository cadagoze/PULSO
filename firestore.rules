rules_version = '2';

// PULSO — cada persona sólo puede leer y escribir sus propios datos (users/{uid}/...).
// Se publican en Firebase → Firestore Database → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['schema', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // Un documento por registro: el contenido va como JSON en `json`, con la hora del servidor.
      match /{collection}/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && collection in ['docs', 'workouts', 'foodLog', 'weights', 'water', 'readiness', 'measurements']
          && request.resource.data.keys().hasOnly(['json', 'deleted', 'updatedAt'])
          && request.resource.data.json is string
          && request.resource.data.json.size() < 900000
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
